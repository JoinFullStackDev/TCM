# ──────────────────────────────────────────────────────────────────────────────
# TCM — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ─── Vercel Cron Security ────────────────────────────────────────────────────
# Protects /api/cron/* routes. Vercel sets Authorization: Bearer <CRON_SECRET>
# automatically. Set this to any strong random string.
CRON_SECRET=<your-cron-secret>

# ─── Agent Activity Monitor ──────────────────────────────────────────────────
# (Added 2026-05-30 — see ARC plan: Architecture: TCM Agent Activity Monitor)

# Base URL for OpenClaw gateway API (used by kill/restart proxy calls)
OPENCLAW_API_URL=http://localhost:3001

# Shared API key for TCM-to-OpenClaw server-side calls (X-OpenClaw-Key header)
OPENCLAW_API_KEY=<your-openclaw-api-key>

# Feature flag: set to "true" only after OpenClaw session kill/spawn API is built.
# When "false", kill and restart DB updates proceed but OpenClaw is not called.
# UI shows a warning when this is off.
OPENCLAW_INTEGRATION_ENABLED=false

# Also expose to the browser so the UI can show/hide the OpenClaw warning:
NEXT_PUBLIC_OPENCLAW_INTEGRATION_ENABLED=false

# Stale-run timeout window in minutes. Runs with no heartbeat for this long
# are marked timed_out by the /api/cron/timeout-agent-runs cron job.
# Default: 10
AGENT_TIMEOUT_MINUTES=10

# Server-to-server key for Clutch agent monitor writes (generate with: openssl rand -hex 32)
CLUTCH_API_KEY=

# ─── MCP Agent Attribution ────────────────────────────────────────────────────
# UUID of the dedicated Clutch Agent profile row in profiles — required for headless Clutch-key writes
# Create via: INSERT INTO profiles (id, full_name, email, role) VALUES (gen_random_uuid(), 'Clutch Agent', 'clutch@agent.internal', 'viewer')
MCP_AGENT_USER_ID=

# ─── Partner API Simulator ───────────────────────────────────────────────────
# Drives FullStackRx's Partner Order API (/v1/*) from TCM (/partner-sim).
# None of these are required. QA enters each partner's API base URL, key and webhook
# secret in the UI.
# Encryption key for stored partner keys (64 hex chars, `openssl rand -hex 32`). When
# unset, one is derived from SUPABASE_SERVICE_ROLE_KEY.
# PARTNER_SIM_ENCRYPTION_KEY=
# QA tests on staging (TCM's server makes the calls; QA's FullStackRx is VPN-only).
# Pre-fill the API base URL when QA creates a partner for that environment.
# PARTNER_SIM_STAGING_API_URL=https://demo.fullstackrx.com
# Link the environment's interactive API docs (<UI base>/partner-api-docs).
# PARTNER_SIM_STAGING_UI_URL=https://demo.fullstackrx.com
# Origin FullStackRx should send webhooks to, if not the one TCM is browsed on.
# PARTNER_SIM_WEBHOOK_BASE_URL=
